# Cache and temporary files
/cache/*
/debug/*
/downloads/*
/file-history/*
/paste-cache/*
/session-env/*
/sessions/*
/shell-snapshots/*
/statsig/*
/telemetry/*
/todos/*
/plans/*
/tasks/*
/backups/*
/projects/*
/chrome/*
/memory/*
/plugins/cache/*
/daemon/*
/jobs/*
/state/*

# Sensitive/local data
/history.jsonl
/stats-cache.json
/.credentials.json
daemon.log

# Claude installer (system file, not user config)
/install.sh

# MacOS
.DS_Store

# Claude Code writes its runtime state as JSON and lock files. Ignore them all and track the
# config by exception, so each new state file needs no entry of its own.
*.json
*.lock
!/settings.json
!/keybindings.json
!/plugins/blocklist.json
!/skills/dream/territory.json

# Marketplace plugins (can be re-fetched)
/plugins/marketplaces/

# Preserve directory structure
!/**/.keep
