lazygit
lazygit.tar.gz
.config/gcloud/*
.config/filezilla/*
.config/go/*
.config/iterm2*
.claude/*local*.*
.config/.wrangler/*
.config/gh/*

# Local overrides anywhere under the Claude config — real paths, vault locations and
# anything else that should not reach a public repository.
.config/.claude/**/*.local.json

# dream skill: machine-local operational state, not config.
# Snapshots are a full copy of the knowledge store per run, so tracking them would
# put the vault's contents in this repo and grow it by ~200 files a night.
.config/.claude/skills/dream/snapshots/
.config/.claude/skills/dream/state.json
.config/.claude/skills/dream/last-run.log

.DS_Store


# Preserve directory structure
!**/.keep

# Claude Code runtime state: timestamps, auth status, policy stamps and the
# claude.ai-synced skills and plugins, which are re-downloaded on demand.
# installed_plugins.json records absolute project paths, so it names private repos.
.config/.claude/.last-cleanup
.config/.claude/.last-update-result.json
.config/.claude/daemon-auth-cooldown
.config/.claude/daemon-auth-status.json
.config/.claude/policy-limits.json.stamp.json
.config/.claude/plugins/.last_inuse_sweep
.config/.claude/plugins/installed_plugins.json
.config/.claude/plugins/synced/
.config/.claude/skills/synced/
